# Port for the Bun server
PORT=3000
# Where the SQLite cache lives
CACHE_DB=data/cache.sqlite
# Optional: set to "1" to skip background refresh (useful in tests)
DISABLE_SCHEDULER=0
# Optional: path to the Carbon Majors CSV (free login at carbonmajors.org)
# CARBON_MAJORS_DIR=data/carbon-majors   (any file name inside works)
